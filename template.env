# Copy to .env (gitignored) and fill in.
# Settings use the GWFLO_ prefix; nested fields use the __ delimiter.

# Rabbit broker URL — amqp:// for non-TLS, amqps:// for TLS. On a gated
# broker the actor's own cert, CN = its GNodeId:
# GWFLO_RABBIT__TLS__CA_CERT_PATH=/home/flo/.config/gridworks/flo/certs/ca.crt
# GWFLO_RABBIT__TLS__CERT_PATH=/home/flo/.config/gridworks/flo/certs/flo.crt
# GWFLO_RABBIT__TLS__PRIVATE_KEY_PATH=/home/flo/.config/gridworks/flo/certs/flo.pem
GWFLO_RABBIT__URL=amqp://smqPublic:smqPublic@localhost:5672/d1__1

# The GNode's alias: <universe>.flo (d1.flo in dev, hw1.flo in prod). It
# MUST equal the Alias in the identity file, which defaults to the XDG
# config path ~/.config/gridworks/flo/g.node.gt.json.
GWFLO_SERVICE_ALIAS=d1.flo
# GWFLO_G_NODE_PATH=/home/flo/.config/gridworks/flo/g.node.gt.json

GWFLO_LOG_LEVEL=INFO

# The control plane the Orchestrator tier answers to.
GWFLO_SUPER_ALIAS=d1.super1
GWFLO_TIME_COORDINATOR_ALIAS=d1.time

# The build workers: how many builds run at once, and how long after a
# request arrives its reply is still worth sending. The box is sized for
# WORKERS times the all-tanks build peak (2 GB measured, 2026-11-01).
GWFLO_WORKERS=2
GWFLO_REPLY_DEADLINE_S=240
